{
  "name": "fantasy-survivors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.stats.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:build-policy && node --experimental-strip-types tests/model.test.ts && vitest run",
    "test:e2e": "node tests/browser.mjs && node tests/alpha-browser.mjs && node tests/campaign-browser.mjs && node tests/activities-browser.mjs && node tests/art-browser.mjs",
    "test:e2e:extended": "E2E_EXTENDED=1 npm run test:e2e && node tests/mobile-browser.mjs && node tests/english-screens.mjs",
    "test:stats": "vitest run tests/character-stats",
    "test:combat": "vitest run tests/combat-core",
    "test:weapons": "vitest run tests/weapon-attacks",
    "test:status": "vitest run tests/status-effects",
    "test:enemies": "vitest run tests/enemy-ai",
    "test:survival": "vitest run tests/player-survival",
    "test:alpha": "vitest run tests/gameplay",
    "test:skills": "vitest run tests/skills",
    "test:campaign": "vitest run tests/campaign",
    "test:profile": "vitest run tests/profile",
    "test:persistence": "vitest run tests/persistence",
    "test:talents": "vitest run tests/talents",
    "test:equipment": "vitest run tests/equipment",
    "test:pets": "vitest run tests/pets",
    "test:quests": "vitest run tests/quests",
    "test:production": "node tests/alpha-production.mjs",
    "build:qa": "npm run typecheck && vite build --mode qa",
    "test:build-policy": "node tests/qa-build.test.mjs && node tests/build-info.test.mjs",
    "test:qa": "node tests/alpha-qa.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
